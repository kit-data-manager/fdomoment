# Keycloak settings for authentication
NEXT_PUBLIC_KEYCLOAK_URL=https://<keycloak-host>
NEXT_PUBLIC_KEYCLOAK_REALM=<keycloak-realm>
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=<keyloak-client-id>

# FDO Service Configuration
# FDO_SERVICE_MODE: 'local' (default) or 'remote'
# - 'local': Uses the in-memory Next.js API route at /api/fdoservice
# - 'remote': Forwards requests to REMOTE_FDO_SERVICE_ENDPOINT
FDO_SERVICE_MODE=local

# REMOTE_FDO_SERVICE_ENDPOINT: Base URL of the remote Spring Boot FDO service
# Only used when FDO_SERVICE_MODE=remote
REMOTE_FDO_SERVICE_ENDPOINT=http://localhost:8080